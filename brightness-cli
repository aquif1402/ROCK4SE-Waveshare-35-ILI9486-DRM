#!/usr/bin/env python3
"""
CLI Utility to query and control screen brightness via brightness_overlay daemon.
Usage:
  brightness-cli get
  brightness-cli set <10-100>
  brightness-cli up [step]
  brightness-cli down [step]
  brightness-cli toggle-ui
  brightness-cli show-ui
  brightness-cli hide-ui
"""

import sys
import socket
import json

SOCKET_PATH = "/tmp/brightness_overlay.sock"

def send_cmd(cmd_str):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCKET_PATH)
        s.sendall(cmd_str.strip().encode("utf-8"))
        data = s.recv(1024).decode("utf-8").strip()
        s.close()
        return json.loads(data)
    except FileNotFoundError:
        print("Error: brightness_overlay daemon is not running (socket not found).", file=sys.stderr)
        sys.exit(1)
    except ConnectionRefusedError:
        print("Error: brightness_overlay daemon socket connection refused.", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

def print_help():
    print("""Brightness Overlay Control CLI
Usage:
  brightness-cli get              Show current brightness and overlay opacity
  brightness-cli set <10-100>     Set brightness percentage
  brightness-cli up [5]           Increase brightness by step (default 5%)
  brightness-cli down [5]         Decrease brightness by step (default 5%)
  brightness-cli toggle           Toggle on-screen control panel
  brightness-cli show             Show on-screen control panel
  brightness-cli hide             Hide on-screen control panel
""")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)
        
    cmd = sys.argv[1].lower()
    
    if cmd in ("-h", "--help", "help"):
        print_help()
        sys.exit(0)
    elif cmd == "get":
        res = send_cmd("GET")
        if res.get("status") == "ok":
            b = res["brightness"]
            op = res["opacity"]
            print(f"Brightness: {b}% (Overlay Opacity: {op * 100:.1f}%)")
        else:
            print("Failed to get status:", res)
    elif cmd == "set":
        if len(sys.argv) < 3:
            print("Usage: brightness-cli set <10-100>", file=sys.stderr)
            sys.exit(1)
        res = send_cmd(f"SET {sys.argv[2]}")
        if res.get("status") == "ok":
            print(f"Brightness set to: {res['brightness']}%")
        else:
            print("Error:", res.get("message", res))
    elif cmd == "up":
        step = sys.argv[2] if len(sys.argv) > 2 else "5"
        res = send_cmd(f"UP {step}")
        if res.get("status") == "ok":
            print(f"Brightness: {res['brightness']}% (+{step}%)")
        else:
            print("Error:", res)
    elif cmd == "down":
        step = sys.argv[2] if len(sys.argv) > 2 else "5"
        res = send_cmd(f"DOWN {step}")
        if res.get("status") == "ok":
            print(f"Brightness: {res['brightness']}% (-{step}%)")
        else:
            print("Error:", res)
    elif cmd in ("toggle", "toggle-ui"):
        res = send_cmd("TOGGLE_UI")
        print("UI toggled.")
    elif cmd in ("show", "show-ui"):
        res = send_cmd("SHOW_UI")
        print("UI opened.")
    elif cmd in ("hide", "hide-ui"):
        res = send_cmd("HIDE_UI")
        print("UI collapsed.")
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
